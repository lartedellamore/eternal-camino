{
  "name": "GivingEntry",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "enum": ["trip", "gift"], "description": "trip = travel spend logged; gift = donation made" },
    "label": { "type": "string", "description": "Trip name or organisation" },
    "amount": { "type": "number", "description": "Amount in the home currency" },
    "currency": { "type": "string", "description": "ISO currency code" },
    "date": { "type": "string", "format": "date" }
  },
  "required": ["kind", "label", "amount"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
